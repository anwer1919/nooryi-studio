generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  phone         String?
  role          String    @default("USER")
  artistId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  permissions   String[]  @default([])
  
  managedArtist Artist?   @relation("ArtistManagerRelation", fields: [artistId], references: [id])
  notifications Notification[]
  payments      Payment[] @relation("PaymentConfirmer")
  
  @@index([email])
  @@map("users")
}

model Artist {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  category              String?
  bio                   String?   @db.Text
  profileImage          String?   @db.Text
  coverImage            String?   @db.Text
  accentColor           String?   @default("#EAB308")
  status                String    @default("PENDING")
  commissionRate        Float     @default(15)
  commissionDiscountVal Float     @default(0)
  adminUserId           String?
  userId                String?

  bankName        String?
  bankAccount     String?
  iban            String?
  vodafoneCash    String?
  instaPay        String?
  paymentNote     String?

  genres          String[]  @default([])
  basePrice       Float     @default(0)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  bookings              Booking[]
  reviews               Review[]
  pricing               Pricing[]
  availability          Availability[]
  managers              User[]    @relation("ArtistManagerRelation")
  pricingRegions        PricingRegion[]
  pricingRules          PricingRule[]
  
  @@index([slug])
  @@map("artists")
}

model Customer {
  id        String    @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  city      String?
  address   String?
  notes     String?
  userId    String?   @unique
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  bookings  Booking[]
  
  @@index([email])
  @@index([userId])
  @@map("customers")
}

model Venue {
  id        String    @id @default(cuid())
  name      String
  address   String?
  city      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  bookings  Booking[]
  
  @@map("venues")
}

model Booking {
  id              String    @id @default(cuid())
  artistId        String
  customerId      String?
  userId          String?
  venueId         String
  clientName      String
  clientPhone     String
  clientEmail     String?
  date            DateTime
  timeSlot        String
  status          String    @default("PENDING_APPROVAL")
  grossAmount     Float     @default(0)
  depositAmount   Float     @default(0)
  remainingAmount Float     @default(0)
  adminNotes      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  region          String?
  countryCode     String?   @default("+20")
  phoneNumber     String?
  travelFee       Float?    @default(0)
  
  artist          Artist    @relation(fields: [artistId], references: [id])
  customer        Customer? @relation(fields: [customerId], references: [id])
  venue           Venue     @relation(fields: [venueId], references: [id])
  payments        Payment[]
  
  @@index([clientEmail])
  @@index([userId])
  @@index([artistId])
  @@map("bookings")
}

model Payment {
  id            String    @id @default(cuid())
  bookingId     String
  amount        Float
  status        String    @default("PENDING")
  method        String    @default("CREDIT_CARD")
  transactionId String?
  confirmedBy   String?
  confirmedAt   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  booking       Booking   @relation(fields: [bookingId], references: [id])
  confirmer     User?     @relation("PaymentConfirmer", fields: [confirmedBy], references: [id])
  
  @@index([bookingId])
  @@map("payments")
}

model Review {
  id         String    @id @default(cuid())
  artistId   String
  userId     String?
  bookingId  String?
  rating     Int
  comment    String?
  clientName String?
  customerId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  
  artist     Artist    @relation(fields: [artistId], references: [id])
  
  @@index([artistId])
  @@map("reviews")
}

model Pricing {
  id          String    @id @default(cuid())
  artistId    String
  name        String
  description String?
  price       Float
  duration    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  artist      Artist    @relation(fields: [artistId], references: [id])
  
  @@index([artistId])
  @@map("pricings")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String    @default("info")
  link      String?
  relatedId String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  user      User      @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model GeneratedReport {
  id            String   @id @default(cuid())
  reportNumber  String   @unique
  type          String   @default("REPORT")
  title         String
  generatedFor  String
  dateFrom      DateTime?
  dateTo        DateTime?
  totalAmount   Float    @default(0)
  platformFee   Float    @default(0)
  netAmount     Float    @default(0)
  bookingsCount Int      @default(0)
  data          Json
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
}

model Availability {
  id          String   @id @default(cuid())
  artistId    String
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean  @default(true)
  
  date        DateTime?
  status      String    @default("AVAILABLE")
  isBooked    Boolean   @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([artistId, dayOfWeek, startTime])
  @@index([artistId])
  @@index([date])
  @@map("availabilities")
}

model PricingRegion {
  id          String   @id @default(cuid())
  artistId    String
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  
  regionName  String
  basePrice   Float
  travelFee   Float    @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([artistId, regionName])
  @@index([artistId])
  @@map("pricing_regions")
}

model PricingRule {
  id          String   @id @default(cuid())
  artistId    String
  artist      Artist   @relation(fields: [artistId], references: [id])
  name        String
  description String?
  price       Float
  duration    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([artistId])
  @@map("pricing_rules")
}

model SiteSetting {
  id            String   @id @default("site_settings")
  siteName      String   @default("Nooryi Studio")
  tagline       String   @default("منصة حجز الفنانين الأولى")
  email         String?
  phone         String?
  address       String?
  currency      String   @default("EGP")
  timezone      String   @default("Africa/Cairo")
  
  facebook      String?
  instagram     String?
  tiktok        String?
  youtube       String?
  whatsapp      String?
  twitter       String?
  
  paymentPhone  String?
  bankName      String?
  bankAccount   String?
  iban          String?
  paymentNote   String?
  
  updatedAt     DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  createdAt  DateTime @default(now())
  attempts   Int      @default(0)

  @@index([identifier])
  @@unique([identifier, token])
}