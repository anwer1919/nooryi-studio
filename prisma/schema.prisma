generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  phone         String?
  role          String    @default("USER") // USER, ADMIN, SUPER_ADMIN, ARTIST_MANAGER
  artistId      String?   // لربط مدير الأعمال بالفنان
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  permissions   String[]  @default([])
  
  // العلاقات
  managedArtist Artist?   @relation("ArtistManagerRelation", fields: [artistId], references: [id])
  notifications Notification[]
  payments      Payment[] @relation("PaymentConfirmer")
  
  @@map("users")
}

model Artist {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  category              String?
  bio                   String?
  profileImage          String?
  coverImage            String?
  accentColor           String?   @default("#EAB308")
  status                String    @default("PENDING") // PENDING, ACTIVE, INACTIVE
  commissionRate        Float     @default(15)
  commissionDiscountVal Float     @default(0)
  adminUserId           String?
  userId                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  // العلاقات
  bookings              Booking[]
  reviews               Review[]
  pricing               Pricing[]
  availability          Availability[]
  managers              User[]    @relation("ArtistManagerRelation")
  
  @@map("artists")
}

model Customer {
  id        String    @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  city      String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  bookings  Booking[]
  
  @@map("customers")
}

model Venue {
  id        String    @id @default(cuid())
  name      String
  address   String?
  city      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  bookings  Booking[]
  
  @@map("venues")
}

model Booking {
  id              String    @id @default(cuid())
  artistId        String
  customerId      String?
  userId          String?
  venueId         String
  clientName      String
  clientPhone     String
  clientEmail     String?
  date            DateTime
  timeSlot        String
  status          String    @default("PENDING_APPROVAL")
  grossAmount     Float     @default(0)
  depositAmount   Float     @default(0)
  remainingAmount Float     @default(0)
  adminNotes      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // العلاقات
  artist          Artist    @relation(fields: [artistId], references: [id])
  customer        Customer? @relation(fields: [customerId], references: [id])
  venue           Venue     @relation(fields: [venueId], references: [id])
  payments        Payment[]
  
  @@map("bookings")
}

model Payment {
  id            String    @id @default(cuid())
  bookingId     String
  amount        Float
  status        String    @default("PENDING") // PENDING, COMPLETED, FAILED
  method        String    @default("CREDIT_CARD")
  transactionId String?
  confirmedBy   String?
  confirmedAt   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  booking       Booking   @relation(fields: [bookingId], references: [id])
  confirmer     User?     @relation("PaymentConfirmer", fields: [confirmedBy], references: [id])
  
  @@map("payments")
}

model Review {
  id        String    @id @default(cuid())
  artistId  String
  userId    String?
  bookingId String?
  rating    Int
  comment   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  artist    Artist    @relation(fields: [artistId], references: [id])
  
  @@map("reviews")
}

model Pricing {
  id          String    @id @default(cuid())
  artistId    String
  name        String
  description String?
  price       Float
  duration    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  artist      Artist    @relation(fields: [artistId], references: [id])
  
  @@map("pricings")
}

model Availability {
  id          String    @id @default(cuid())
  artistId    String
  bookingId   String?
  date        DateTime
  timeSlot    String
  isBooked    Boolean   @default(false)
  price       Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  artist      Artist    @relation(fields: [artistId], references: [id])
  
  @@map("availabilities")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String    @default("info")
  link      String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  user      User      @relation(fields: [userId], references: [id])
  
  @@map("notifications")
}